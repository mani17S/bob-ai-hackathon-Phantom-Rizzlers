# ---------------------------------------------------------------------------
# Frontend environment template - copy to `.env.local` and fill in values.
# NEVER commit `.env.local` (it is git-ignored).
# ---------------------------------------------------------------------------

# Base URL of the REST API (e.g. FastAPI backend).
# Leave EMPTY to run in demo mode: the app renders built-in mock data instead.
VITE_API_URL=""

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS="15000"
